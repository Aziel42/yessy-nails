# ================================================================
# YESSY NAILS — Variables de Entorno
# Copia este archivo como .env y coloca tus propias credenciales.
# ================================================================

# Puerto del servidor
PORT=3000

# ── Supabase (PostgreSQL + Auth) ────────────────────────────────
# Proyecto Supabase > Project Settings > API
SUPABASE_URL=https://TU-PROYECTO.supabase.co

# Llaves legacy (recomendado: el backend las usa por defecto)
SUPABASE_ANON_KEY=tu_anon_key_aqui
SUPABASE_SERVICE_ROLE_KEY=tu_service_role_key_aqui

# Llaves nuevas Publishable / Secret (opcionales).
# El backend acepta cualquiera de las dos nomenclaturas: si defines
# SUPABASE_PUBLISHABLE_KEY / SUPABASE_SECRET_KEY también funcionará.
# SUPABASE_PUBLISHABLE_KEY=
# SUPABASE_SECRET_KEY=

# NOTA: ya no se usan JWT_SECRET, ADMIN_USER ni ADMIN_PASSWORD.
# La autenticación se realiza contra Supabase Auth.

# ── Servicio de Correo Electrónico ──────────────────────────────
# Prioridad 1: API HTTP de Brevo (recomendado en la nube, no usa SMTP)
# Crear cuenta gratis en https://www.brevo.com → API Keys
BREVO_API_KEY=tu_brevo_api_key_aqui
EMAIL_FROM=yessicacalderon@tudominio.com
EMAIL_FROM_NAME=Yessy Nails
EMAIL_REPLY_TO=yessicacalderon@tudominio.com

# Correo al que llegan los avisos internos (citas nuevas, pedidos, etc.)
# Si está vacío se usa EMAIL_FROM
ADMIN_EMAIL=yessicacalderon@tudominio.com

# Prioridad 2: Respaldo con Nodemailer (Gmail App Password)
# Solo se usa si BREVO_API_KEY o EMAIL_FROM no están configurados.
# Para Gmail: activar verificación en dos pasos y generar una "App Password".
# EMAIL_USER=tu-cuenta@gmail.com
# EMAIL_PASS=xxxx_xxxx_xxxx_xxxx

# URL pública del sitio (se usa en botones de los correos)
# SITE_URL=https://yessyNails.com
