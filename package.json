{
  "name": "yessy-nails",
  "version": "1.0.0",
  "description": "Aplicación web profesional para Yessy Nails — Salón de uñas de Yessica Marlen Calderón Luna",
  "type": "module",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "test": "cross-env NODE_ENV=test node --experimental-vm-modules node_modules/jest/bin/jest.js --forceExit"
  },
  "jest": {
    "testEnvironment": "node",
    "transform": {},
    "testMatch": [
      "**/tests/**/*.test.js"
    ]
  },
  "keywords": [
    "nail-salon",
    "beauty",
    "appointments",
    "express",
    "supabase"
  ],
  "author": "Yessica Marlen Calderón Luna",
  "license": "PRIVATE",
  "dependencies": {
    "@supabase/supabase-js": "^2.119.2",
    "cors": "^2.8.5",
    "dotenv": "^18.0.10",
    "express": "^4.21.0",
    "multer": "^2.5.0",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "cross-env": "^10.1.0",
    "jest": "^30.5.2",
    "supertest": "^7.3.2"
  }
}
